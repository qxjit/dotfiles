#!/usr/bin/env nu

# Dev workflow helpers. Run a subcommand; see the list below.
def main [] {
  # This definition also carries the subcommands: nushell only dispatches
  # `main <sub>` when a bare `main` exists, and without it every subcommand in
  # this file silently does nothing and exits 0.
  help main
}

# Spawn or attach to a zellij dev session. Defaults to the session named `dev`;
# name another to keep more than one going side by side. Every other `dev`
# command acts on whichever of them it is run from.
def "main t" [
  session: string = "dev"  # zellij session to spawn or attach to
] {
  $env.EDITOR = "hx"
  exec zellij attach -c $session
}

# Pick up the claude session already running in the current directory, or
# start a fresh one. Declining to start drops to a shell instead. Resuming a
# live session opens the same conversation here while the original keeps
# running in its own terminal.
def "main claude" [] {
  let sessionId = (try {
    chooseSession (runningSessionsIn $env.PWD)
  } catch { |err|
    print $err.msg
    input "Press enter to close" | ignore
    return
  })

  match $sessionId {
    "shell" => { exec ($env.SHELL? | default "fish") }
    "new" => { exec claude }
    _ => { exec claude --resume $sessionId }
  }
}

def runningSessionsIn [dir: string] {
  claude agents --json
  | from json
  | where kind == "interactive" and cwd == $dir
  | sort-by --reverse startedAt
}

def chooseSession [sessions: table] {
  if ($sessions | is-empty) {
    let answer = (input "No claude is running here. Start one? [Y/n] " | str trim | str lowercase)

    return (if $answer in ["n", "no"] { "shell" } else { "new" })
  }

  if ($sessions | length) == 1 {
    return $sessions.0.sessionId
  }

  print "Claude sessions running here:"
  for it in ($sessions | enumerate) {
    print $"  ($it.index + 1). ($it.item.name) [($it.item.status)]"
  }

  let typed = (input "Resume which? [1] " | str trim)
  let index = (if ($typed | is-empty) { 1 } else { $typed | into int }) - 1

  if $index < 0 or $index >= ($sessions | length) {
    error make {msg: $"No session numbered ($index + 1)"}
  }

  ($sessions | get $index).sessionId
}

# Open go to a zellij tab for a specific project
def "main o" [
  project?: string  # project name or directory, prompted for when omitted
] {
  requireZellijSession

  if $project != null {
    openProjectTab (resolveTarget $project)
    return
  }

  let typed = (input "Open project: " | str trim)

  let resolved = (if ($typed | is-empty) {
    null
  } else {
    try {
      resolveTarget $typed
    } catch { |err|
      print $err.msg
      input "Press enter to close" | ignore
      null
    }
  })

  zellij action hide-floating-panes

  if $resolved != null {
    openProjectTab $resolved
  }
}

# Only using directory target if the project argument looks like a path.
# Otherwise try to resolve it as a bare project name and only fall back
# to directory if that is unsuccessful
def resolveTarget [project: string] {
  if (looksLikePath $project) {
    directoryTarget $project
  } else {
    try { resolveProject $project } catch { directoryTarget $project }
  }
}

def openProjectTab [resolved: record] {
  let tabs = zellij action query-tab-names

  if ($tabs | lines | any { |it| $it == $resolved.name }) {
    zellij action go-to-tab-name $resolved.name
  } else {
    cd $resolved.dir
    zellij action new-tab --layout ide --name $resolved.name
  }
}

# Close the focused zellij tab once its name has been typed back
def "main tab close" [] {
  requireZellijSession

  let typed = (input "Type the name of this tab to close it, or press enter to keep it: " | str trim)

  if ($typed | is-empty) {
    zellij action hide-floating-panes
    return
  }

  let focused = (zellij action dump-layout | parse --regex 'tab name="(?<name>[^"]*)" focus=true')

  if ($focused | is-empty) {
    error make {msg: "Could not find the focused tab"}
  }

  if $typed == $focused.0.name {
    zellij action close-tab
  } else {
    zellij action hide-floating-panes
  }
}

# Stop unless this shell is inside a zellij session, naming what is running when
# it is not. `zellij action` picks its target out of $env.ZELLIJ_SESSION_NAME, so
# from inside a session the tab always lands in that one -- but run from a plain
# terminal it falls back to guessing: with several sessions alive it refuses, and
# with exactly one it silently drives that one, which is the wrong session as
# soon as `dev t` is used to keep more than one going.
def requireZellijSession [] {
  if ($env.ZELLIJ_SESSION_NAME? | default "" | is-not-empty) {
    return
  }

  let listed = (do { ^zellij list-sessions -s -n } | complete)
  let live = (if $listed.exit_code == 0 {
    $listed.stdout | lines | where { |s| $s | is-not-empty }
  } else {
    []
  })

  let hint = (if ($live | is-empty) {
    "No sessions are running; `dev t` starts one."
  } else {
    $"Running: ($live | str join ', '). `dev t <session>` attaches to one."
  })

  error make {msg: $"Not inside a zellij session. ($hint)"}
}

def resolveProject [project: string] {
  let matches = (glob ($env.HOME)/work/*/($project))

  if ($matches | is-empty) {
    error make {msg: $"Could not find a project or directory matching '($project)'"}
  }

  {name: $project, dir: $matches.0}
}

# Whether the argument was written as a path rather than a bare project name.
def looksLikePath [project: string] {
  ($project | str contains "/") or ($project | str starts-with "~") or ($project in [".", ".."])
}

# A directory named on the command line, resolved to the tab name and directory
# to open. Errors rather than falling back to a project lookup, so a mistyped
# path is reported as itself instead of being hunted for under ~/work.
def directoryTarget [path: string] {
  if not (($path | path exists) and (($path | path type) == "dir")) {
    error make {msg: $"Could not find a project or directory matching '($path)'"}
  }

  let dir = ($path | path expand)

  {name: ($dir | path basename), dir: $dir}
}
