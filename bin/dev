#!/usr/bin/env nu

# Open a file in the helix pane on the same tab.
# Finds helix by pane command rather than relying on layout position.
def main [path: string] {
  let tab = (zellij action current-tab-info --json | from json)
  let panes = (zellij action list-panes --json | from json)
  let hx_pane = ($panes | where is_plugin == false and tab_id == $tab.tab_id and terminal_command != null | where ($it.terminal_command | str starts-with "hx") | first)
  let pane_id = $"terminal_($hx_pane.id)"

  let escaped = ($path | str replace --all ' ' '\ ')
  zellij action write-chars --pane-id $pane_id $":e ($escaped)"
  zellij action write --pane-id $pane_id 13
}

# Spawn or attach to a zellij dev session
def "main t" [] {
  $env.EDITOR = "hx"
  exec zellij attach -c dev
}

# Open go to a zellij tab for a specific project
def "main o" [project: string] {
  let tabs = zellij action query-tab-names

  # Only using directory target if the project argument looks like a path.
  # Otherwise try to resolve it as a bare project name and only fall back
  # to directory if that is unsuccessful
  let resolved = if (looksLikePath $project) {
    directoryTarget $project
  } else {
    try { resolveProject $project } catch { directoryTarget $project }
  }

  if ($tabs | lines | any { |it| $it == $resolved.name }) {
    zellij action go-to-tab-name $resolved.name
  } else {
    cd $resolved.dir
    zellij action new-tab --layout ide --name $resolved.name
  }
}

def "main story branch" [story: string, branch:string ...projects: string] {
  let storyDir = $"($env.HOME)/work/stories/($story)"
  mkdir $storyDir
  $projects | each { |project|
    let resolved = resolveProject $project
    let projectStoryDir = $"($storyDir)/($project)" 

    cd $resolved.dir
    git fetch
    git worktree add $projectStoryDir -b $branch origin/main

    cd $projectStoryDir

    # Point the branch at origin/<branch> rather than the origin/main it was cut
    # from, so a plain `git push` publishes it under its own name. Written as
    # config because --set-upstream-to requires the remote branch to already
    # exist; until the first push, `git status` will show the upstream as gone.
    git config $"branch.($branch).remote" origin
    git config $"branch.($branch).merge" $"refs/heads/($branch)"

    ./scripts/bootstrap
  }
}

# Interactively clean up everything a story leaves behind: the worktrees each
# project registered under ~/work/stories/<story>, every local or remote branch
# named for the story, whatever `dev review` recorded against those worktrees, and
# the story directory itself. Worktrees whose directory is already gone are simply
# unregistered, so this works the same whether or not the story directory has
# already been removed by hand.
def "main story cleanup" [story: string] {
  if ($story | is-empty) or ($story | str contains "/") or ($story | str starts-with ".") {
    error make {msg: $"'($story)' is not a usable story name"}
  }

  let storyDir = $"($env.HOME)/work/stories/($story)"
  let worktrees = (storyWorktrees $storyDir)
  let db = (reviewDb)

  if ($worktrees | is-empty) {
    print $"No worktrees are registered under (tildify $storyDir)."
  } else {
    print $"($worktrees | length) worktree\(s\) registered under (tildify $storyDir):"
  }
  print ""

  mut removed = 0
  mut deleted = 0
  mut deletedRemote = 0
  # Branches answered for here are not raised again by the sweep below, so a
  # deliberate "keep this one" is not re-litigated a screen later.
  mut decided = []

  for wt in $worktrees {
    let onDisk = ($wt.path | path exists)
    let dirty = ($onDisk and (worktreeIsDirty $wt.path))
    let state = (if not $onDisk {
      "directory already gone"
    } else if $dirty {
      "still on disk, HAS UNCOMMITTED CHANGES"
    } else {
      "still on disk, clean"
    })

    print $"  ($wt.project)  in (tildify $wt.repo)"
    print $"    worktree: (tildify $wt.path) — ($state)"
    if $wt.branch == null {
      print $"    branch:   none \(detached HEAD\)"
    } else {
      print $"    branch:   ($wt.branch) — (describeBranch $wt.repo $wt.branch)"
    }

    let answer = (if $wt.branch == null {
      promptChoice ["y" "s" "q"] "    Unregister worktree? [y]es [s]kip [q]uit: "
    } else {
      promptChoice ["y" "w" "s" "q"] "    [y] worktree + branch  [w] worktree only  [s]kip  [q]uit: "
    })

    if $answer == "q" {
      print ""
      print $"Unregistered ($removed) worktree\(s\), deleted ($deleted) branch\(es\)."
      print $"Quit early, so (tildify $storyDir) was left alone."
      return
    }

    if $wt.branch != null {
      $decided = ($decided | append $"($wt.repo)|($wt.branch)")
    }

    if $answer != "s" {
      if (removeWorktree $wt.repo $wt.path $dirty) {
        $removed = $removed + 1

        # Review state is keyed by the worktree's own path, so once the worktree
        # is gone those rows can never match a hunk again.
        forgetWorktreeReviews $db $wt.path

        if $answer == "y" and $wt.branch != null {
          if (deleteBranch $wt.repo $wt.branch) {
            $deleted = $deleted + 1
          }
        }
      }
    }

    print ""
  }

  # Branches named for the story but not accounted for above: left over from a
  # worktree deleted by hand, cut outside `story branch`, or pushed and then
  # abandoned. Deletions on the remote are reconciled first, so what shows up
  # here still exists; branches pushed by someone else and never fetched do not
  # appear at all, since finding those would mean fetching all 60-odd repos.
  let strays = (storyBranches $story $decided)

  if ($strays | is-not-empty) {
    print $"($strays | length) other branch\(es\) named for ($story):"
    print ""
  }

  for b in $strays {
    print $"  ($b.name)  in (tildify $b.repo)"
    if $b.local {
      print $"    local:    (describeBranch $b.repo $b.name)"
    } else if $b.localHeld {
      print $"    local:    still present, kept earlier in this run"
    }
    for r in $b.remotes {
      print $"    remote:   ($r)/($b.name) — (describeRemoteBranch $b.repo $r $b.name)"
    }

    let bothActionable = ($b.local and ($b.remotes | is-not-empty))
    let answer = (if $bothActionable {
      promptChoice ["b" "l" "r" "s" "q"] "    [b] local + remote  [l] local only  [r] remote only  [s]kip  [q]uit: "
    } else if $b.local {
      promptChoice ["y" "s" "q"] "    Delete local branch? [y]es [s]kip [q]uit: "
    } else {
      promptChoice ["y" "s" "q"] $"    Delete ($b.remotes | str join ', ') copy \(pushes a deletion\)? [y]es [s]kip [q]uit: "
    })

    if $answer == "q" {
      print ""
      print $"Unregistered ($removed) worktree\(s\), deleted ($deleted) local and ($deletedRemote) remote branch\(es\)."
      print $"Quit early, so (tildify $storyDir) was left alone."
      return
    }

    let killLocal = ($b.local and ($answer in ["b" "l"] or ($answer == "y" and not $bothActionable)))
    let killRemote = (($b.remotes | is-not-empty) and ($answer in ["b" "r"] or ($answer == "y" and not $b.local)))

    if $killLocal and (deleteBranch $b.repo $b.name) {
      $deleted = $deleted + 1
    }

    if $killRemote {
      for r in $b.remotes {
        if (deleteRemoteBranch $b.repo $r $b.name) {
          $deletedRemote = $deletedRemote + 1
        }
      }
    }

    print ""
  }

  print $"Unregistered ($removed) worktree\(s\), deleted ($deleted) local and ($deletedRemote) remote branch\(es\)."

  # Whatever is left in the story directory is not tracked by git -- notes,
  # build artifacts, worktrees the user chose to keep -- so list it before
  # asking, rather than quietly deleting it along with the empty husks.
  if ($storyDir | path exists) {
    let leftovers = (ls --all --short-names $storyDir | get name | sort)

    print ""
    if ($leftovers | is-empty) {
      print $"(tildify $storyDir) is now empty."
    } else {
      print $"(tildify $storyDir) still contains:"
      for l in $leftovers { print $"    ($l)" }
    }

    # Deleting the directory out from under a worktree that is still registered
    # just recreates the stale entries this command exists to clear.
    let stillRegistered = (storyWorktrees $storyDir)
    if ($stillRegistered | is-not-empty) {
      print $"  ! ($stillRegistered | length) worktree\(s\) here are still registered; deleting now would strand them."
    }

    if (promptChoice ["y" "n"] $"  Delete (tildify $storyDir)? [y/n]: ") == "y" {
      rm -rf $storyDir
      print $"  ✓ deleted (tildify $storyDir)"

      # Anything still recorded under here belongs to a worktree that went away by
      # hand rather than through this command.
      let orphaned = (forgetReviewsUnder $db $storyDir)

      if $orphaned > 0 {
        print $"  ✓ forgot ($orphaned) reviewed line\(s\) recorded under it"
      }
    }
  }
}

# Every main repository under ~/work. Linked worktrees are skipped: they report
# the same worktrees and the same refs as the repository they belong to, which
# would double-count every entry.
def workRepos [] {
  glob $"($env.HOME)/work/*/*" --no-file --no-symlink
    | where { |repo| not ($repo | str starts-with $"($env.HOME)/work/stories/") }
    | where { |repo| ($repo | path join ".git" | path exists) and (($repo | path join ".git" | path type) == "dir") }
}

# Every registered worktree, across every project in ~/work, that lives inside
# the given story directory.
def storyWorktrees [storyDir: string] {
  workRepos
    | each { |repo| repoWorktreesUnder $repo $"($storyDir)/" }
    | flatten
    | sort-by project
}

# Every branch named for the story, local or remote, that the worktree pass did
# not already settle. `decided` holds "<repo>|<branch>" keys answered there; a
# decided branch still surfaces if it has remote copies, since removing a
# worktree says nothing about what is sitting on the remote.
def storyBranches [story: string, decided: list<string>] {
  let repos = (workRepos)
  let found = ($repos | each { |repo| repoStoryBranches $repo $story $decided } | flatten)

  # A remote-tracking ref outlives the branch it points at until something
  # prunes it, so half these hits can be branches that were deleted on the
  # remote long ago. Only the remote knows which, and asking costs a network
  # round trip -- so ask just the repos that actually matched, not all 60.
  let pairs = ($found
    | each { |b| $b.remotes | each { |r| {repo: $b.repo, remote: $r} } }
    | flatten
    | uniq)

  if ($pairs | is-empty) {
    return ($found | sort-by repo name)
  }

  print $"Pruning stale remote refs in ($pairs | get repo | uniq | length) repo\(s\)..."
  for p in $pairs { pruneRemote $p.repo $p.remote }

  # Repos with no remote hits cannot have been changed by a prune, so only the
  # ones just contacted are worth reading a second time.
  let pruned = ($pairs | get repo | uniq)

  $found
    | where { |b| not ($b.repo in $pruned) }
    | append ($pruned | each { |repo| repoStoryBranches $repo $story $decided } | flatten)
    | sort-by repo name
}

# Failure here is usually a remote that cannot be reached at all -- no VPN, no
# network. That is not fatal: the stale refs simply stay listed, so say so
# rather than dropping branches that might be real.
def pruneRemote [repo: string, remote: string] {
  let result = (do { ^git -C $repo remote prune $remote } | complete)

  if $result.exit_code != 0 {
    print $"  ! could not reach ($remote) for (tildify $repo); its refs may be stale"
    return
  }

  # Pruning is per-remote, not per-story, so this also clears dead refs left by
  # unrelated work. Harmless -- they point at branches the remote no longer has
  # -- but report the count rather than rewriting refs silently.
  let cleared = ($result.stdout | lines | where { |l| $l | str contains "[pruned]" } | length)

  if $cleared > 0 {
    print $"  pruned ($cleared) dead ref\(s\) in (tildify $repo)"
  }
}

def repoStoryBranches [repo: string, story: string, decided: list<string>] {
  let refs = (do { ^git -C $repo for-each-ref --format="%(refname)" refs/heads refs/remotes } | complete)

  if $refs.exit_code != 0 {
    return []
  }

  let parsed = ($refs.stdout | lines | each { |ref| parseRef $ref } | compact)
  let locals = ($parsed | where kind == "local" | get name | where { |n| isStoryBranch $n $story })
  let remotes = ($parsed | where kind == "remote" | where { |r| isStoryBranch $r.name $story })

  $locals
    | append ($remotes | get name)
    | uniq
    | each { |name|
        let held = ($"($repo)|($name)" in $decided)
        let copies = ($remotes | where name == $name | get remote)

        # A branch settled during the worktree pass with nothing on any remote
        # is finished business; asking about it again would be noise.
        if $held and ($copies | is-empty) {
          null
        } else {
          {
            repo: $repo,
            name: $name,
            local: ((not $held) and ($name in $locals)),
            localHeld: ($held and ($name in $locals)),
            remotes: $copies,
          }
        }
      }
    | compact
}

# refs/heads/<name> and refs/remotes/<remote>/<name>, split on the first path
# component so branch names containing slashes survive intact. origin/HEAD is a
# symbolic pointer at the default branch, not a branch anyone can delete.
def parseRef [ref: string] {
  if ($ref | str starts-with "refs/heads/") {
    {kind: "local", remote: null, name: ($ref | str substring 11..)}
  } else if ($ref | str starts-with "refs/remotes/") {
    let parts = ($ref | str substring 13.. | split row "/")

    if (($parts | length) < 2) or (($parts | skip 1 | str join "/") == "HEAD") {
      null
    } else {
      {kind: "remote", remote: ($parts | first), name: ($parts | skip 1 | str join "/")}
    }
  } else {
    null
  }
}

# Story numbers are not safe string prefixes of one another -- sc-2268 leads
# sc-22685 -- so only the whole story segment counts as a match.
def isStoryBranch [name: string, story: string] {
  ($name == $story) or ($name | str starts-with $"($story)/")
}

# Parse `git worktree list --porcelain` for one repository, keeping only the
# worktrees under `prefix`. Records are blank-line separated; each has a
# `worktree <path>` line plus either `branch refs/heads/<name>` or `detached`.
def repoWorktreesUnder [repo: string, prefix: string] {
  let listed = (do { ^git -C $repo worktree list --porcelain } | complete)

  if $listed.exit_code != 0 {
    return []
  }

  $listed.stdout
    | split row "\n\n"
    | each { |record|
        let fields = ($record | lines | where { |l| $l | is-not-empty })
        let path = ($fields | where { |l| $l | str starts-with "worktree " } | each { |l| $l | str substring 9.. } | get 0?)
        let branchRef = ($fields | where { |l| $l | str starts-with "branch " } | each { |l| $l | str substring 7.. } | get 0?)

        if ($path == null) or (not ($path | str starts-with $prefix)) {
          null
        } else {
          {
            repo: $repo,
            project: ($path | path basename),
            path: $path,
            branch: (if $branchRef == null { null } else { $branchRef | str replace "refs/heads/" "" }),
          }
        }
      }
    | compact
}

# How far a branch has drifted from the mainline and from its remote, so the
# choice to delete it can be made without leaving the prompt.
def describeBranch [repo: string, branch: string] {
  let base = (baseRef $repo)
  let ahead = (if $base == null { null } else { commitCount $repo $"($base)..($branch)" })
  let upstream = (remoteCounterpart $repo $branch $base)
  let unpushed = (if $upstream == null { null } else { commitCount $repo $"($upstream)..($branch)" })

  let vsBase = (if $ahead == null {
    "no mainline to compare against"
  } else if $ahead == 0 {
    $"fully merged into ($base)"
  } else {
    $"($ahead) commit\(s\) not in ($base)"
  })

  let vsRemote = (if $upstream == null {
    "never pushed"
  } else if $unpushed == 0 {
    $"pushed to ($upstream)"
  } else {
    $"($unpushed) commit\(s\) NOT pushed to ($upstream)"
  })

  $"($vsBase), ($vsRemote)"
}

def baseRef [repo: string] {
  ["origin/main" "origin/master" "main" "master"]
    | where { |r| refExists $repo $r }
    | get 0?
}

# The remote branch that would hold this work if it were pushed. `story branch`
# builds story branches off origin/main, which leaves them tracking origin/main
# rather than a branch of their own -- an upstream that says nothing about
# whether the work survives deletion -- so that case falls through to looking
# for a remote branch of the same name.
def remoteCounterpart [repo: string, branch: string, base: any] {
  let result = (do { ^git -C $repo rev-parse --abbrev-ref --symbolic-full-name $"($branch)@{upstream}" } | complete)
  let upstream = (if $result.exit_code == 0 { $result.stdout | str trim } else { null })

  if ($upstream != null) and ($upstream != $base) {
    $upstream
  } else if (refExists $repo $"origin/($branch)") {
    $"origin/($branch)"
  } else {
    null
  }
}

def describeRemoteBranch [repo: string, remote: string, name: string] {
  let base = (baseRef $repo)
  let ahead = (if $base == null { null } else { commitCount $repo $"($base)..($remote)/($name)" })

  if $ahead == null {
    "no mainline to compare against"
  } else if $ahead == 0 {
    $"fully merged into ($base)"
  } else {
    $"($ahead) commit\(s\) not in ($base)"
  }
}

def refExists [repo: string, ref: string] {
  (do { ^git -C $repo rev-parse --verify --quiet $ref } | complete).exit_code == 0
}

def commitCount [repo: string, range: string] {
  let result = (do { ^git -C $repo rev-list --count $range } | complete)

  if $result.exit_code == 0 { $result.stdout | str trim | into int } else { null }
}

def worktreeIsDirty [path: string] {
  let result = (do { ^git -C $path status --porcelain } | complete)

  ($result.exit_code == 0) and (($result.stdout | str trim) | is-not-empty)
}

# `git worktree remove` prunes an already-deleted directory happily, but refuses
# a live one holding uncommitted work. Forcing past that destroys the work, so
# make it a separate, explicit decision rather than a flag on the first answer.
def removeWorktree [repo: string, path: string, dirty: bool] {
  let result = (do { ^git -C $repo worktree remove $path } | complete)

  if $result.exit_code == 0 {
    print "    ✓ unregistered worktree"
    return true
  }

  print $"    ! ($result.stderr | str trim)"

  if $dirty and ((promptChoice ["y" "n"] "    Force removal, discarding those changes? [y/n]: ") == "y") {
    let forced = (do { ^git -C $repo worktree remove --force $path } | complete)

    if $forced.exit_code == 0 {
      print "    ✓ unregistered worktree \(forced)"
      return true
    }

    print $"    ! ($forced.stderr | str trim)"
  }

  false
}

# -D rather than -d: the prompt already showed the unmerged and unpushed counts,
# so a refusal here would only re-litigate a decision the user just made.
def deleteBranch [repo: string, branch: string] {
  let result = (do { ^git -C $repo branch -D $branch } | complete)

  if $result.exit_code == 0 {
    print $"    ✓ deleted branch ($branch)"
    true
  } else {
    print $"    ! ($result.stderr | str trim)"
    false
  }
}

# Unlike everything else here this reaches past the machine, so it names the
# remote it is about to change in both the prompt and the confirmation.
def deleteRemoteBranch [repo: string, remote: string, name: string] {
  let result = (do { ^git -C $repo push $remote --delete $name } | complete)

  if $result.exit_code == 0 {
    print $"    ✓ deleted ($remote)/($name) on ($remote)"
    true
  } else {
    print $"    ! ($result.stderr | str trim)"
    false
  }
}

def promptChoice [choices: list<string>, prompt: string] {
  loop {
    let answer = (input $prompt | str trim | str downcase)

    if $answer in $choices {
      return $answer
    }

    print $"    Please answer one of: ($choices | str join ', ')"
  }
}

def tildify [path: string] {
  $path | str replace $env.HOME "~"
}

# Launch a file tree configured to operate in conjuction with the zellij layout
def "main file-tree" [] {
  $env.EDITOR = "dev"
  exec bt
}

# Walk the change set one hunk at a time: show the hunk, then mark it reviewed,
# defer it, or open $EDITOR on it and choose again. Operates on the staged change
# set by default; pass --unstaged for tracked working-tree changes, --untracked
# for new (not-ignored) files, or --amend for the most recent commit. With
# --amend, the hunks of HEAD (per `git show`) are shown, and if anything was
# edited the touched files are re-staged and `git commit --amend` runs so the
# fixes fold back into that commit and the message can be reworded.
#
# What has been reviewed is remembered in ~/.local/state/dev/review.db, a line at
# a time rather than a hunk at a time: each added or removed line is keyed by the
# repository, the file, the text of the line and which copy of that text it is in
# the file. Nothing positional goes in, so a change stays reviewed when it slides
# up or down the file, when the lines around it are rewritten, and when git draws
# the hunk boundaries somewhere else -- all of which happen constantly in a tree
# still being worked on. A hunk is skipped only when every line it changes has
# been reviewed; add one line to a hunk answered for earlier and it comes back
# with that line colored and the rest dimmed.
#
# Fixing a hunk from the prompt doesn't count as new work: an edited hunk is
# recorded both as it was shown and as it reads afterwards. Deferring is per-run:
# deferred hunks are listed at the end and come back next time.
#
# `review forget` throws that record away for the files under the current
# directory, and `story cleanup` throws away what belongs to the worktrees it
# removes.
#
# Hunks in each file are visited bottom-to-top so edits above don't shift the
# line numbers of hunks not yet visited.
def "main review" [
  --unstaged   # review hunks from unstaged (tracked working-tree) changes instead of staged
  --untracked  # review hunks from untracked, non-ignored files instead of staged
  --amend      # review hunks from the most recent commit, then re-stage and `git commit --amend`
] {
  let root = (git rev-parse --show-toplevel | str trim)

  # Which commit this is, since with `review branch` the answer is a different one
  # each time the prompt comes back.
  if $amend {
    printCommit $root
  }
  let scope = (if $amend { "most recent commit" } else if $untracked { "untracked" } else if $unstaged { "unstaged" } else { "staged" })
  let diff = (if $amend {
    # Drop the commit header/message with --format= so only the diff remains.
    git show --format= --no-color HEAD
  } else if $untracked {
    untrackedDiff $root
  } else if $unstaged {
    git diff --no-color
  } else {
    git diff --cached --no-color
  })

  let parsed = (parseHunks $diff)
  # A hunk that removes a file has nothing left on disk to show or edit.
  let gone = ($parsed | where file == "/dev/null" | length)
  let hunks = ($parsed | where file != "/dev/null" | keyHunks $root)

  # How to re-read a file that gets edited mid-review. A fix lands in the working
  # tree, so each mode compares against whatever will be the "before" side once
  # that fix is staged, or amended in: for staged review that is HEAD, since the
  # fix has to be added before it counts as staged.
  let rebase = (if $amend {
    ["HEAD^" "--"]
  } else if $untracked {
    ["--no-index" "--" "/dev/null"]
  } else if $unstaged {
    ["--"]
  } else {
    ["HEAD" "--"]
  })

  if ($hunks | is-empty) and $gone == 0 {
    print $"No hunks found in the ($scope) change set."
    return
  }

  let db = (reviewDb)
  let known = (reviewedKeys $db $root)
  # A hunk is settled only when every line it changes has been reviewed. One new
  # line in a hunk that was reviewed before brings the hunk back, with the lines
  # already answered for dimmed so the new one is the part that stands out.
  let pending = ($hunks | markSeen $known | where newCount > 0 | sort-by file line --reverse)
  let alreadyReviewed = (($hunks | length) - ($pending | length))
  let total = ($pending | length)

  if $alreadyReviewed > 0 {
    print $"Skipping ($alreadyReviewed) hunk\(s\) reviewed earlier."
  }
  if $gone > 0 {
    print $"Skipping ($gone) hunk\(s\) in deleted files."
  }
  if $total == 0 {
    print $"Nothing left to review in the ($scope) change set."
    return
  }

  mut reviewed = 0
  mut deferred = []
  mut edited = []
  mut quit = false

  for i in 0..<$total {
    if $quit { break }

    let h = ($pending | get $i)
    let label = (if $h.newCount == ($h.keys | length) {
      $"Hunk (($i + 1))/($total)  ($h.file):($h.line)"
    } else {
      $"Hunk (($i + 1))/($total)  ($h.file):($h.line)  \(($h.newCount) of ($h.keys | length) changed lines are new\)"
    })

    showHunk $h $label

    # Never auto-mark a line belonging to a hunk still queued to be asked about;
    # see editedHunks for what would otherwise reach past the hunk being edited.
    let queued = ($pending | where line != $h.line or file != $h.file | get keys | flatten)
    mut hunkEdited = false

    # Editing re-asks rather than deciding for the user: what to make of the
    # hunk is usually clearer after the fix than before it.
    loop {
      let answer = (promptChoice ["r" "d" "e" "s" "q"] "  [r]eviewed  [d]efer  [e]dit  [s]how again  [q]uit: ")

      if $answer == "e" {
        editFileAt ($root | path join $h.file) $h.line
        $edited = ($edited | append $h.file)
        $hunkEdited = true

        # A full-screen editor takes the diff off the screen on its way out, so
        # the hunk is shown again -- as it now reads, not as it was.
        showEdited $root $h $rebase $label $known
      } else if $answer == "s" {
        if $hunkEdited {
          showEdited $root $h $rebase $label $known
        } else {
          showHunk $h $label
        }
      } else if $answer == "r" {
        recordReviewed $db $root $h.file $h.keys

        # An edited hunk is recorded twice: as it was shown, and as it now
        # stands, so the fix doesn't come back next pass as new work.
        if $hunkEdited {
          let fixed = (editedHunks $root $h $rebase $known
            | get keys
            | flatten
            | where { |k| not ($k in $queued) })

          recordReviewed $db $root $h.file $fixed

          if ($fixed | is-not-empty) {
            print $"  ✓ reviewed, along with the edited version of the hunk"
          }
        }

        $reviewed = $reviewed + 1
        break
      } else if $answer == "d" {
        $deferred = ($deferred | append $h)
        break
      } else {
        $quit = true
        break
      }
    }
  }

  print ""
  # Quitting leaves both the hunk on screen and the ones after it unanswered, so
  # they count together rather than as hunks nobody looked at.
  print $"($reviewed) reviewed, ($deferred | length) deferred, ($total - $reviewed - ($deferred | length)) left."

  for d in $deferred {
    print $"  deferred: ($d.file):($d.line)"
  }

  # Fold the edits back into HEAD and let the user reword the message. A pass
  # that changed nothing has nothing to amend, so it doesn't open the message
  # editor just to close it again.
  if $amend and ($edited | is-not-empty) {
    for f in ($edited | uniq) {
      git -C $root add -- $f
    }
    git -C $root commit --amend
  }

  # Under `review branch` this runs from a rebase, one commit at a time, and each
  # run that exits cleanly lets the rebase roll on to the next commit. Quitting
  # means quitting the branch too, so it fails on purpose to stop the sequencer
  # where it stands -- git then explains how to resume or abandon it.
  if $quit and (rebaseInProgress $root) {
    print "Quit, so the rebase is paused on this commit."
    exit 1
  }
}

# Forget what has been recorded about the files under the current directory, so
# they come up for review from scratch. Run at the top of a repository it clears
# the whole repository; run in a subdirectory it clears only what is under that
# subdirectory. Worktrees are their own repository as far as this goes, so
# forgetting one says nothing about the others or about the main checkout.
def "main review forget" [] {
  let root = (git rev-parse --show-toplevel | str trim)
  let here = ($env.PWD | path expand)
  let db = (reviewDb)
  let rows = (open $db | query db "SELECT hash, file FROM reviewed WHERE repo = ?" -p [$root])
  # At the top of the repository every file is under here, and `path relative-to`
  # would give "." rather than a prefix to match on.
  let doomed = (if $here == $root {
    $rows
  } else {
    let prefix = $"($here | path relative-to $root)/"

    $rows | where { |r| $r.file | str starts-with $prefix }
  })

  if ($doomed | is-empty) {
    print $"Nothing is recorded for the files under (tildify $here)."
    return
  }

  let files = ($doomed | get file | uniq)

  print $"($doomed | length) reviewed line\(s\) across ($files | length) file\(s\) under (tildify $here)."
  print "  Forgetting them means reviewing those changes again from scratch."

  if (promptChoice ["y" "n"] "  Forget them? [y/n]: ") != "y" {
    print "  left alone"
    return
  }

  forgetFiles $db $root $files
  print $"  ✓ forgot ($doomed | length) reviewed line\(s\)"
}

# Review a whole branch commit by commit, in the order the commits were written:
# rebase onto the point where the branch left the mainline and stop after each
# commit to run `review --amend` on it, so a fix lands in the commit that
# introduced the line rather than in a follow-up at the tip. This is the
# interactive rebase you would write by hand -- `edit` on every commit, review,
# `git rebase --continue` -- with the continuing done for you.
#
# Commits reviewed without edits keep their hashes. From the first commit that is
# actually amended onward, hashes change, since every commit after it is rebuilt
# on the new parent. Reviewed hunks are keyed by content, so that rewriting
# doesn't make already-reviewed hunks look new again.
#
# Quitting a commit's review leaves the rebase paused there: pick it back up with
# `git rebase --continue`, or put the branch back with `git rebase --abort`.
def "main review branch" [
  --base: string  # review commits after this ref instead of after the mainline merge base
] {
  let root = (git rev-parse --show-toplevel | str trim)

  if (rebaseInProgress $root) {
    error make {msg: "A rebase is already in progress; finish it with `git rebase --continue` or drop it with `git rebase --abort` first"}
  }

  # A rebase won't start over modified tracked files, and reviewing a commit means
  # editing files, so both want a clean tree to begin with. Untracked files don't
  # bother either, so they don't bother this.
  if (trackedChanges $root) {
    error make {msg: "There are staged or unstaged changes; commit or stash them before reviewing the branch"}
  }

  let start = (if $base == null {
    branchRoot $root
  } else if (refExists $root $base) {
    $base
  } else {
    error make {msg: $"'($base)' is not a ref in this repository"}
  })

  let commits = (git -C $root rev-list --reverse $"($start)..HEAD" | lines | where { |c| $c | is-not-empty })

  if ($commits | is-empty) {
    print $"No commits between (shortSha $root $start) and HEAD to review."
    return
  }

  print $"($commits | length) commit\(s\) on top of (shortSha $root $start):"
  for c in $commits {
    print $"  (commitSummary $root $c)"
  }
  print ""

  # `--exec` is the whole trick: it appends the review to the todo after every
  # pick, so each commit is reviewed on its way past and the sequencer carries on
  # by itself unless the review fails.
  try {
    ^git -C $root rebase --exec $"'(reviewScript)' review --amend" $start
  } catch {
    print ""
    print "The rebase stopped early. `git rebase --continue` picks it up from there, `git rebase --abort` puts the branch back as it was."
    return
  }

  print $"Reviewed ($commits | length) commit\(s\)."
}

# This script's own path, so a rebase runs the same copy that started it rather
# than whichever `dev` happens to be on PATH.
def reviewScript [] {
  $env.CURRENT_FILE? | default "dev"
}

# Where the branch parted from the mainline.
def branchRoot [repo: string] {
  let base = (baseRef $repo)

  if $base == null {
    error make {msg: "Found no mainline ref (origin/main, origin/master, main, master) to measure the branch against; name a starting point with --base"}
  }

  let result = (do { ^git -C $repo merge-base HEAD $base } | complete)

  if $result.exit_code != 0 {
    error make {msg: $"HEAD and ($base) have no commit in common; name a starting point with --base"}
  }

  $result.stdout | str trim
}

# The commit being amended, plus how far along the rebase is when there is one.
def printCommit [repo: string] {
  let subject = (gitLine $repo ["show" "--no-patch" "--format=%h %s" "HEAD"])
  let author = (gitLine $repo ["show" "--no-patch" "--format=%an, %ar" "HEAD"])
  let stat = (gitLine $repo ["show" "--shortstat" "--format=" "HEAD"] | str trim)
  let at = (rebasePosition $repo)
  let heading = (if $at == null { "Commit" } else { $"Commit ($at)" })

  # A merge commit reports no shortstat at all, so the separator goes with it.
  let changes = (if ($stat | is-empty) { "" } else { $" — ($stat)" })

  print ""
  print $"(ansi attr_bold)($heading)  ($subject)(ansi reset)"
  print $"  ($author)($changes)"
}

def commitSummary [repo: string, commit: string] {
  gitLine $repo ["show" "--no-patch" "--format=%h %s" $commit]
}

# The last non-empty line of a git command's output, or "" if it said nothing.
# Written for the one-line `show --format=` reads above, where a merge commit or a
# missing ref means no output rather than an error worth reporting.
def gitLine [repo: string, args: list<string>] {
  let result = (do { ^git -C $repo ...$args } | complete)
  let lines = ($result.stdout | lines | where { |l| $l | is-not-empty })

  if ($result.exit_code != 0) or ($lines | is-empty) { "" } else { $lines | last }
}

# The state directory of a rebase in progress: rebase-merge for the sequencer,
# rebase-apply for the older patch-based one.
def rebaseDir [repo: string] {
  let result = (do { ^git -C $repo rev-parse --absolute-git-dir } | complete)

  if $result.exit_code != 0 {
    return null
  }

  let gitDir = ($result.stdout | str trim)

  ["rebase-merge" "rebase-apply"]
    | each { |d| $gitDir | path join $d }
    | where { |p| $p | path exists }
    | get 0?
}

def rebaseInProgress [repo: string] {
  (rebaseDir $repo) != null
}

# How far along the rebase is, as "2/3", counted in commits rather than in todo
# entries: `review branch` puts an exec after every pick, so git's own msgnum
# would say 4/6 where the reviewer can see they are on the second commit of three.
def rebasePosition [repo: string] {
  let dir = (rebaseDir $repo)

  if $dir == null {
    return null
  }

  let done = (todoCommits ($dir | path join "done"))
  let left = (todoCommits ($dir | path join "git-rebase-todo"))

  if $done == 0 { null } else { $"($done)/($done + $left)" }
}

# Entries in a rebase todo that produce a commit of their own, in either the long
# or the one-letter spelling. Fixups and squashes fold into the commit before
# them, so they are not commits of the branch and are not counted as such.
def todoCommits [path: string] {
  if not ($path | path exists) {
    return 0
  }

  open $path
    | lines
    | where { |l| ($l | str trim | split row " " | first) in ["pick" "p" "edit" "e" "reword" "r"] }
    | length
}

# Modified tracked files, staged or not.
def trackedChanges [repo: string] {
  let unstaged = ((do { ^git -C $repo diff --quiet } | complete).exit_code != 0)
  let staged = ((do { ^git -C $repo diff --cached --quiet } | complete).exit_code != 0)

  $unstaged or $staged
}

def shortSha [repo: string, ref: string] {
  let result = (do { ^git -C $repo rev-parse --short $ref } | complete)

  if $result.exit_code == 0 { $result.stdout | str trim } else { $ref }
}

# Collect every hunk of a unified diff as
# {file, start, newLen, line, header, body, changed}. Deleted files are reported
# under their `+++` path of /dev/null for the caller to skip.
def parseHunks [diff: string] {
  mut results = []
  mut curFile = ""
  mut newLine = 0
  mut hunkStart = 0
  # 0 means "no changed line seen in this hunk yet"; real anchors start at 1, and
  # nushell won't let a mutable variable start out as null and then hold an int.
  mut anchor = 0
  mut header = ""
  mut body = []
  mut changed = []
  mut inHunk = false

  for line in ($diff | lines) {
    # Body lines carry a ' ', '+', '-' or '\' prefix, so a header only counts as
    # a header while no hunk is open; otherwise a diff of a patch file would read
    # its own contents as headers.
    if (not $inHunk) and ($line | str starts-with "+++ ") {
      let p = ($line | str substring 4..)
      $curFile = (if ($p | str starts-with "b/") { $p | str substring 2.. } else { $p })
    } else if ($line | str starts-with "@@") {
      if $inHunk {
        $results = ($results | append (hunkRecord $curFile $hunkStart $anchor ($newLine - $hunkStart) $header $body $changed))
      }

      let m = ($line | parse --regex '@@ -\d+(?:,\d+)? \+(?<start>\d+)')
      if ($m | is-empty) {
        $inHunk = false
      } else {
        $hunkStart = ($m.0.start | into int)
        $newLine = $hunkStart
        $anchor = 0
        $header = $line
        $body = []
        $changed = []
        $inHunk = true
      }
    } else if $inHunk and ($line | str starts-with "diff --git ") {
      # End of this file's hunks; the next `+++` names the file that follows.
      $results = ($results | append (hunkRecord $curFile $hunkStart $anchor ($newLine - $hunkStart) $header $body $changed))
      $inHunk = false
    } else if $inHunk {
      # Removed lines don't advance the new-file counter, so anchoring on the
      # first change of either kind lands on the same line for a replacement.
      if ($line | str starts-with "+") {
        if $anchor == 0 { $anchor = $newLine }
        $changed = ($changed | append $line)
        $body = ($body | append $line)
        $newLine = $newLine + 1
      } else if ($line | str starts-with "-") {
        if $anchor == 0 { $anchor = $newLine }
        $changed = ($changed | append $line)
        $body = ($body | append $line)
      } else if ($line | str starts-with " ") {
        $body = ($body | append $line)
        $newLine = $newLine + 1
      } else if ($line | str starts-with '\') {
        $body = ($body | append $line)
      }
    }
  }

  if $inHunk {
    $results = ($results | append (hunkRecord $curFile $hunkStart $anchor ($newLine - $hunkStart) $header $body $changed))
  }

  $results
}

# One hunk, with `start`/`newLen` giving the span it covers in the new file and
# `line` anchoring at its first changed line rather than its header, so an editor
# opens on the change instead of the leading context. A hunk that only deletes
# lines anchors at the position the deleted lines used to occupy.
def hunkRecord [file: string, start: int, anchor: int, newLen: int, header: string, body: list<string>, changed: list<string>] {
  {
    file: $file,
    start: $start,
    newLen: $newLen,
    line: (if $anchor == 0 { $start } else { $anchor }),
    header: $header,
    body: $body,
    changed: $changed,
  }
}

# Give every hunk a `keys` list, one key per line the hunk adds or removes, in the
# order those lines appear in it.
#
# A key is the repository, the file, the line exactly as the diff writes it
# (leading + or - included, so adding a line and removing it are not the same
# change), and which copy of that text this is within the file. No line numbers
# and no context go in, so a change keeps its key when it slides up or down the
# file or when the lines around it are rewritten -- which is the whole point,
# since that is what an unstaged tree does all day.
#
# The copy number is what keeps twins apart. Two files' worth of identical
# `+ foo` lines each get their own key, and within one file the second copy is a
# different key from the first, so reviewing one leaves the other to be reviewed.
# Read the state as "this file has had N copies of this exact line reviewed": add
# a copy and exactly one hunk comes back, remove one and nothing does, which is
# the behaviour that survives lines being shuffled around.
def keyHunks [root: string] {
  let hunks = $in

  # One id per changed line, in diff order, which is what makes the copy numbering
  # below deterministic.
  let ids = ($hunks | each { |h| $h.changed | each { |text| lineId $root $h.file $text } } | flatten)

  if ($ids | is-empty) {
    return ($hunks | each { |h| $h | insert keys [] })
  }

  # The copy numbers without a closure per line, which on a branch of a few
  # thousand changed lines is the difference between a fifth of a second and two
  # seconds: sorting by id, ties in diff order, gathers each id's copies into one
  # run; `uniq --count` measures those runs in that same order; so the copy numbers
  # are just 0..count-1 for each run, laid end to end against the sorted lines.
  let sorted = ($ids | enumerate | sort-by item index)
  let ordinals = ($sorted | get item | uniq --count | each { |r| seq 0 ($r.count - 1) } | flatten)
  let keys = ($sorted
    | zip $ordinals
    | each { |p| {at: $p.0.index, key: ($"($p.0.item)\u{0}($p.1)" | hash sha256)} }
    | sort-by at
    | get key)

  # Hand the flat list of keys back out to the hunks the lines came from.
  mut out = []
  mut taken = 0

  for h in $hunks {
    let mine = ($h.changed | length)

    $out = ($out | append ($h | insert keys ($keys | skip $taken | first $mine)))
    $taken = $taken + $mine
  }

  $out
}

# The identity of one changed line before its copy number is added. The scheme
# name leads so that a later change to what goes into a key cannot be mistaken for
# a key written under this one.
def lineId [root: string, file: string, text: string] {
  $"line/1\u{0}($root)\u{0}($file)\u{0}($text)" | hash sha256
}

# Show a hunk as it reads after being edited, which may be as two hunks if the
# edit split it, or as nothing at all if the edit undid the change.
def showEdited [root: string, hunk: record, rebase: list<string>, label: string, known: list<string>] {
  let now = (editedHunks $root $hunk $rebase $known)

  if ($now | is-empty) {
    print "  ✎ nothing of this change is left in the file"
  } else {
    for n in $now { showHunk $n $"($label)  \(edited\)" }
  }
}

# Print the hunk the way git colors its own diff. Anything taller than the
# terminal is scrolled in `less` instead, so a long hunk doesn't scroll its own
# header out of view.
#
# `less -X` is the point of running it by hand rather than honouring $PAGER: with
# the alternate screen left alone, quitting the pager leaves the hunk on screen
# to answer the prompt against, rather than wiping it. -F skips the pager for a
# hunk that turns out to fit after all, and -R keeps the colors.
def showHunk [hunk: record, label: string] {
  let text = ([$"(ansi attr_bold)($label)(ansi reset)" $"(ansi cyan)($hunk.header)(ansi reset)"]
    | append (colorBody $hunk)
    | str join "\n")
  # A redirected stdout reports no rows at all; nothing is scrolling away there,
  # so print rather than reaching for a pager.
  let rows = (term size | get rows)

  print ""

  if $rows > 0 and ((($hunk.body | length) + 4) > $rows) {
    try {
      $text | ^less -RFX
    } catch {
      print $text
    }

    # Leaving the alternate screen alone also leaves less's own ":" prompt on the
    # last line, which the next prompt would otherwise be typed onto.
    print ""
  } else {
    print $text
  }
}

# The hunk's body, colored like git's diff except for the changed lines already
# answered for in an earlier pass: those keep their + or - in green or red and dim
# only the text after it, so the shape of the diff still reads at a glance while
# the lines that are new to this pass are the ones that carry color.
#
# Changed lines carry a flag each in `seen`, in the order they appear, so walking
# the body and taking the next flag at every + or - line pairs them back up.
def colorBody [hunk: record] {
  mut out = []
  mut next = 0

  for line in $hunk.body {
    if ($line | str starts-with "+") or ($line | str starts-with "-") {
      let seen = ($hunk.seen | get -o $next | default false)
      let color = (if ($line | str starts-with "+") { ansi green } else { ansi red })
      $next = $next + 1

      $out = ($out | append (if $seen {
        $"($color)($line | str substring 0..0)(ansi reset)(ansi dark_gray)($line | str substring 1..)(ansi reset)"
      } else {
        $"($color)($line)(ansi reset)"
      }))
    } else {
      $out = ($out | append $line)
    }
  }

  $out
}

# Where reviewed lines are remembered. `into sqlite` is the only way to create the
# file from nushell and it takes the schema from the rows it is given, so the table
# is seeded with one row and then emptied.
def reviewDb [] {
  let db = ($env.HOME | path join ".local" "state" "dev" "review.db")

  if not ($db | path exists) {
    mkdir ($db | path dirname)
    [[hash repo file reviewed_at]; ["" "" "" ""]] | into sqlite $db -t reviewed
    open $db | query db "DELETE FROM reviewed" | ignore
  }

  # What makes `INSERT OR REPLACE` replace: a table built by `into sqlite` has no
  # constraint of its own. Databases written before keys went per-line hold rows
  # under the old scheme, which no key can match now, so a duplicate is possible
  # there and the index is not worth failing over.
  try {
    open $db | query db "CREATE UNIQUE INDEX IF NOT EXISTS reviewed_hash ON reviewed(hash)" | ignore
  }

  $db
}

# Only this repository's keys: a key already carries the repository it belongs to,
# so the rest could never match, and leaving them out keeps the join below smaller.
def reviewedKeys [db: string, repo: string] {
  open $db | query db "SELECT DISTINCT hash FROM reviewed WHERE repo = ?" -p [$repo] | get hash
}

# Tag each hunk with which of its changed lines have been reviewed before: `seen`
# holds a flag per line, in step with `keys`, and `newCount` how many are new.
#
# This is one hash join over every changed line rather than a lookup per line. The
# obvious `$key in $known` written per line is a linear scan of the whole record
# each time -- on a branch of a few thousand changed lines against a few thousand
# recorded ones that is tens of millions of comparisons, and several seconds of
# staring at nothing before the first hunk appears.
def markSeen [known: list<string>] {
  let hunks = $in

  if ($known | is-empty) {
    return ($hunks | each { |h|
      $h | insert seen ($h.keys | each { false }) | insert newCount ($h.keys | length)
    })
  }

  # Kept to whole-table operations rather than a closure per line: `wrap` and
  # `enumerate` build the table, `join` matches it against the record in one pass,
  # and `default` fills in the lines that matched nothing. `join` makes no promise
  # about the order it returns rows in, so they are put back in line order before
  # the flags are read off them.
  let flags = ($hunks
    | get keys
    | flatten
    | enumerate
    | rename at key
    | join --left ($known | wrap key | insert seen true) key
    | sort-by at
    | default false seen
    | get seen)

  mut out = []
  mut taken = 0

  for h in $hunks {
    let mine = ($h.keys | length)
    let seen = ($flags | skip $taken | first $mine)

    $out = ($out | append ($h | insert seen $seen | insert newCount ($seen | where { |s| not $s } | length)))
    $taken = $taken + $mine
  }

  $out
}

# Record every line of a reviewed hunk in one statement, since a hunk can easily
# be forty lines and a round trip each would be felt. Reviewing a line again
# replaces its row rather than adding one, so `reviewed_at` reads as the last time
# it was looked at.
def recordReviewed [db: string, root: string, file: string, keys: list<string>] {
  if ($keys | is-empty) {
    return
  }

  let values = ($keys | each { "(?, ?, ?, datetime())" } | str join ", ")
  let params = ($keys | each { |k| [$k, $root, $file] } | flatten)

  open $db
    | query db $"INSERT OR REPLACE INTO reviewed \(hash, repo, file, reviewed_at) VALUES ($values)" -p $params
    | ignore
}

# Delete the recorded lines for particular files of one repository, in batches so
# that a repository with thousands of them stays inside sqlite's limit on how many
# parameters one statement may carry.
def forgetFiles [db: string, repo: string, files: list<string>] {
  for batch in ($files | chunks 400) {
    let holes = ($batch | each { "?" } | str join ", ")

    open $db
      | query db $"DELETE FROM reviewed WHERE repo = ? AND file IN \(($holes))" -p ([$repo] | append $batch)
      | ignore
  }
}

# Forget everything recorded for the repository at a path and for any repository
# underneath it, and answer how many lines that was. Written for paths that are
# being deleted: a removed worktree, or a whole story directory.
def forgetReviewsUnder [db: string, path: string] {
  let repos = (open $db
    | query db "SELECT DISTINCT repo FROM reviewed"
    | get repo
    | where { |r| ($r == $path) or ($r | str starts-with $"($path)/") })

  mut removed = 0

  for repo in $repos {
    $removed = $removed + (open $db | query db "SELECT count(*) as n FROM reviewed WHERE repo = ?" -p [$repo] | get 0.n)
    open $db | query db "DELETE FROM reviewed WHERE repo = ?" -p [$repo] | ignore
  }

  $removed
}

# The same, for a worktree that has just been unregistered, reported in the same
# indented style as the rest of the cleanup it belongs to.
def forgetWorktreeReviews [db: string, path: string] {
  let removed = (forgetReviewsUnder $db $path)

  if $removed > 0 {
    print $"    ✓ forgot ($removed) reviewed line\(s\)"
  }
}

# A hunk as it stands after being edited. Fixing a line changes its key, so the
# keys held for the hunk as it was shown say nothing about the fix -- re-read the
# file and take whichever hunks now cover the span this one occupied. More than one
# comes back when the edit split the hunk in two; none comes back when the edit
# undid the change entirely. `rebase` is the mode's idea of what to diff the
# working tree against.
def editedHunks [root: string, hunk: record, rebase: list<string>, known: list<string>] {
  let diff = (do { ^git -C $root diff --no-color ...$rebase $hunk.file } | complete | get stdout)
  let from = $hunk.start
  # A hunk that only deletes lines covers no new-file lines at all, so its span
  # collapses to the single line the deletion sits between.
  let to = ([$from ($hunk.start + $hunk.newLen - 1)] | math max)

  parseHunks $diff
    | where file == $hunk.file
    | keyHunks $root
    | markSeen $known
    | where { |c| ($c.start <= $to) and (([$c.start ($c.start + $c.newLen - 1)] | math max) >= $from) }
}

# Build a diff for every untracked, non-ignored file by diffing each against
# /dev/null, so the whole file reads as one added hunk. Paths are repo-root
# relative to match `git diff` headers. Binary files produce a "Binary files
# differ" line with no hunks and are skipped naturally.
def untrackedDiff [root: string] {
  let files = (git -C $root ls-files --others --exclude-standard | lines | where { |f| $f | is-not-empty })
  $files
    | each { |f|
        do { ^git -C $root diff --no-index --no-color -- /dev/null $f } | complete | get stdout
      }
    | str join ""
}

# Open $EDITOR at a specific line, using each editor's own jump syntax. A hunk
# that deletes the tail of a file can anchor past its last line, and a file
# deleted outright anchors at 0, so the line is clamped into real numbering.
def editFileAt [file: string, anchor: int] {
  let line = ([$anchor 1] | math max)
  let editor = ($env.EDITOR? | default "vi")
  let base = ($editor | path basename)
  match $base {
    "hx" | "helix" | "kak" => { ^$editor $"($file):($line)" }
    "vim" | "nvim" | "vi" | "nano" => { ^$editor $"+($line)" $file }
    "emacs" | "emacsclient" => { ^$editor $"+($line)" $file }
    "code" | "codium" => { ^$editor -g $"($file):($line)" -w }
    _ => { ^$editor $file }
  }
}

def resolveProject [project: string] {
  let matches = (glob ($env.HOME)/work/*/($project))

  if ($matches | is-empty) {
    error make {msg: $"Could not find a project or directory matching '($project)'"}
  }

  {name: $project, dir: $matches.0}
}

# Whether the argument was written as a path rather than a bare project name.
def looksLikePath [project: string] {
  ($project | str contains "/") or ($project | str starts-with "~") or ($project in [".", ".."])
}

# A directory named on the command line, resolved to the tab name and directory
# to open. Errors rather than falling back to a project lookup, so a mistyped
# path is reported as itself instead of being hunted for under ~/work.
def directoryTarget [path: string] {
  if not (($path | path exists) and (($path | path type) == "dir")) {
    error make {msg: $"Could not find a project or directory matching '($path)'"}
  }

  let dir = ($path | path expand)

  {name: ($dir | path basename), dir: $dir}
}
