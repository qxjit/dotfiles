#!/usr/bin/env nu

# Open a file in the helix pane on the same tab.
# Finds helix by pane command rather than relying on layout position.
def main [path: string] {
  let tab = (zellij action current-tab-info --json | from json)
  let panes = (zellij action list-panes --json | from json)
  let hx_pane = ($panes | where is_plugin == false and tab_id == $tab.tab_id and terminal_command != null | where ($it.terminal_command | str starts-with "hx") | first)
  let pane_id = $"terminal_($hx_pane.id)"

  let escaped = ($path | str replace --all ' ' '\ ')
  zellij action write-chars --pane-id $pane_id $":e ($escaped)"
  zellij action write --pane-id $pane_id 13
}

# Spawn or attach to a zellij dev session
def "main t" [] {
  $env.EDITOR = "hx"
  exec zellij attach -c dev
}

# Open go to a zellij tab for a specific project
def "main o" [project: string] {
  let tabs = zellij action query-tab-names

  # Resolve the tab name and directory to open
  let resolved = if ($project | path exists) and (($project | path type) == "dir") {
    let dir = ($project | path expand)
    {name: ($dir | path basename), dir: $dir}
  } else {
    resolveProject $project
  }

  if ($tabs | lines | any { |it| $it == $resolved.name }) {
    zellij action go-to-tab-name $resolved.name
  } else {
    cd $resolved.dir
    zellij action new-tab --layout ide --name $resolved.name
  }
}

def "main story branch" [story: string, branch:string ...projects: string] {
  let storyDir = $"($env.HOME)/work/stories/($story)"
  mkdir $storyDir
  $projects | each { |project|
    let resolved = resolveProject $project
    let projectStoryDir = $"($storyDir)/($project)" 

    cd $resolved.dir
    git fetch
    git worktree add $projectStoryDir -b $branch origin/main

    cd $projectStoryDir

    ./scripts/bootstrap
  }
}

# Launch a file tree configured to operate in conjuction with the zellij layout
def "main file-tree" [] {
  $env.EDITOR = "dev"
  exec bt
}

# Walk the change set and open $EDITOR on each newly-added comment, one at a
# time. Saving/closing the editor advances to the next comment. Operates on the
# staged change set by default; pass --unstaged for tracked working-tree changes
# or --untracked for new (not-ignored) files.
# A run of adjacent comment lines (consecutive one-liners, or a single
# multi-line block comment) counts as one comment and prompts once, at its
# first line. Comments in each file are visited bottom-to-top so edits above
# don't shift the line numbers of comments not yet visited.
def "main comments" [
  --unstaged   # edit comments from unstaged (tracked working-tree) changes instead of staged
  --untracked  # edit comments from untracked, non-ignored files instead of staged
] {
  let root = (git rev-parse --show-toplevel | str trim)
  let diff = (if $untracked {
    untrackedDiff $root
  } else if $unstaged {
    git diff --unified=0 --no-color
  } else {
    git diff --cached --unified=0 --no-color
  })
  let comments = (parseStagedComments $diff | groupConsecutive | sort-by file line --reverse)

  if ($comments | is-empty) {
    let scope = (if $untracked { "untracked" } else if $unstaged { "unstaged" } else { "staged" })
    print $"No comments found in the ($scope) change set."
    return
  }

  let total = ($comments | length)
  for i in 0..<$total {
    let c = ($comments | get $i)
    print $"Editing comment (($i + 1))/($total): ($c.file):($c.line)"
    editCommentAt ($root | path join $c.file) $c.line
  }
}

# Collect {file, line} for every added comment line in a staged diff produced
# with `git diff --cached --unified=0`. Tracks block-comment state (e.g.
# Haskell `{- -}`, C `/* */`, HTML `<!-- -->`) so interior lines that don't
# begin with a marker are still recognized as comments.
def parseStagedComments [diff: string] {
  mut results = []
  mut curFile = ""
  mut syntax = (commentSyntaxFor "")
  mut newLine = 0
  mut inBlock = false
  mut closeSeq = ""

  for line in ($diff | lines) {
    if ($line | str starts-with "+++ ") {
      let p = ($line | str substring 4..)
      let path = (if ($p | str starts-with "b/") { $p | str substring 2.. } else { $p })
      $curFile = $path
      $syntax = (commentSyntaxFor $path)
      $inBlock = false
      $closeSeq = ""
    } else if ($line | str starts-with "@@") {
      let m = ($line | parse --regex '@@ -\d+(?:,\d+)? \+(?<start>\d+)')
      if not ($m | is-empty) {
        $newLine = ($m.0.start | into int)
      }
      # Added lines within a hunk are contiguous; a block cannot span hunks.
      $inBlock = false
      $closeSeq = ""
    } else if ($line | str starts-with "+++") {
      # header safety net, no line consumed
    } else if ($line | str starts-with "+") {
      let content = ($line | str substring 1..)
      let trimmed = ($content | str trim)
      mut isCmt = false

      if $inBlock {
        $isCmt = true
        if ($content | str contains $closeSeq) {
          $inBlock = false
          $closeSeq = ""
        }
      } else if ($trimmed | is-not-empty) and (not ($syntax.ignore | any { |p| $trimmed | str starts-with $p })) {
        if ($syntax.line | any { |m| $trimmed | str starts-with $m }) {
          $isCmt = true
        } else {
          let opens = ($syntax.blocks | where { |b| $trimmed | str starts-with $b.0 })
          if ($opens | is-not-empty) {
            $isCmt = true
            let b = ($opens | first)
            if not (($trimmed | str replace $b.0 "") | str contains $b.1) {
              $inBlock = true
              $closeSeq = $b.1
            }
          }
        }
      }

      if $isCmt {
        $results = ($results | append {file: $curFile, line: $newLine})
      }
      $newLine = $newLine + 1
    }
  }

  $results
}

# Build a unified=0 diff for every untracked, non-ignored file by diffing each
# against /dev/null, so the whole file reads as added lines. Paths are
# repo-root relative to match `git diff` headers. Binary files produce a
# "Binary files differ" line with no additions and are skipped naturally.
def untrackedDiff [root: string] {
  let files = (git -C $root ls-files --others --exclude-standard | lines | where { |f| $f | is-not-empty })
  $files
    | each { |f|
        do { ^git -C $root diff --no-index --unified=0 --no-color -- /dev/null $f } | complete | get stdout
      }
    | str join ""
}

# Collapse runs of adjacent comment lines (same file, consecutive line
# numbers) into a single {file, line} anchored at the run's first line.
def groupConsecutive [] {
  let rows = $in
  mut groups = []
  mut curFile = ""
  mut startLine = 0
  mut prevLine = 0

  for r in $rows {
    if ($r.file == $curFile) and ($r.line == ($prevLine + 1)) {
      $prevLine = $r.line
    } else {
      if $curFile != "" {
        $groups = ($groups | append {file: $curFile, line: $startLine})
      }
      $curFile = $r.file
      $startLine = $r.line
      $prevLine = $r.line
    }
  }

  if $curFile != "" {
    $groups = ($groups | append {file: $curFile, line: $startLine})
  }

  $groups
}

# Comment syntax keyed off the file extension: `line` leaders, `blocks` as
# [open, close] pairs, and `ignore` prefixes that look like comment openers but
# aren't (e.g. Haskell `{-#` pragmas).
def commentSyntaxFor [path: string] {
  let ext = ($path | path parse | get extension | str downcase)
  match $ext {
    "hs" => { line: ["--"], blocks: [["{-" "-}"]], ignore: ["{-#"] }
    "elm" | "purs" => { line: ["--"], blocks: [["{-" "-}"]], ignore: [] }
    "sql" | "lua" => { line: ["--"], blocks: [], ignore: [] }
    "js" | "jsx" | "ts" | "tsx" | "mjs" | "cjs" | "go" | "rs" | "c" | "h" | "cpp" | "hpp" | "cc" | "java" | "scala" | "kt" | "kts" | "swift" | "php" | "cs" | "dart" | "zig" | "proto" => { line: ["//"], blocks: [["/*" "*/"]], ignore: [] }
    "py" | "rb" | "sh" | "bash" | "zsh" | "fish" | "nu" | "yaml" | "yml" | "toml" | "cfg" | "ini" | "r" | "pl" | "pm" | "tf" => { line: ["#"], blocks: [], ignore: [] }
    "css" | "scss" | "less" => { line: [], blocks: [["/*" "*/"]], ignore: [] }
    "html" | "htm" | "xml" | "vue" | "svelte" | "md" => { line: [], blocks: [["<!--" "-->"]], ignore: [] }
    "clj" | "cljs" | "el" | "lisp" | "scm" | "rkt" => { line: [";"], blocks: [], ignore: [] }
    "vim" => { line: ['"'], blocks: [], ignore: [] }
    _ => { line: ["#" "//" "--" ";"], blocks: [["/*" "*/"] ["{-" "-}"] ["<!--" "-->"]], ignore: ["{-#"] }
  }
}

# Open $EDITOR at a specific line, using each editor's own jump syntax.
def editCommentAt [file: string, line: int] {
  let editor = ($env.EDITOR? | default "vi")
  let base = ($editor | path basename)
  match $base {
    "hx" | "helix" | "kak" => { ^$editor $"($file):($line)" }
    "vim" | "nvim" | "vi" | "nano" => { ^$editor $"+($line)" $file }
    "emacs" | "emacsclient" => { ^$editor $"+($line)" $file }
    "code" | "codium" => { ^$editor -g $"($file):($line)" -w }
    _ => { ^$editor $file }
  }
}

def resolveProject [project: string] {
  let matches = (glob ($env.HOME)/work/*/($project))

  if ($matches | is-empty) {
    error make {msg: $"Could not find a project or directory matching '($project)'"}
  }

  {name: $project, dir: $matches.0}
}
