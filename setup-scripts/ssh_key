#!/usr/bin/env sh

set -e

github_authenticates () {
  ssh -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1 \
    | grep -q "successfully authenticated"
}

if github_authenticates; then
  exit 0
fi

if [ ! -f "$HOME/.ssh/id_ed25519.pub" ]; then
  ssh-keygen -t ed25519 -C "david@flipstone.com" -f "$HOME/.ssh/id_ed25519"
fi

echo ""
echo "Add this ssh key to GitHub at https://github.com/settings/ssh/new"
echo ""
cat "$HOME/.ssh/id_ed25519.pub"
echo ""

until github_authenticates; do
  printf "Press Enter once the key is added to GitHub "
  read -r _
done
